POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Copie para .env e ajuste se necessário.
# Valores abaixo batem com o docker-compose.dev.yml (Postgres local na porta 5433).
DATABASE_URL="postgresql://bolao:bolao@localhost:5433/bolao?schema=public"

# Segredo para assinar o JWT de sessão. Gere um com:
#   openssl rand -base64 48
JWT_SECRET=

# Código de convite exigido no cadastro público (/cadastro).
# Vazio = cadastro desativado. Não diferencia maiúsculas/minúsculas.
SIGNUP_CODE=
