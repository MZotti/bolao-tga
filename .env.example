# Variáveis do docker-compose.yml (PRODUÇÃO).
# Na VPS:  cp .env.example .env  &&  chmod 600 .env  e preencha os valores.
# O .env NUNCA deve ir para o Git.

# Subdomínio do DuckDNS
DOMAIN=bolaotga.duckdns.org

# Banco de dados.
# Use só letras e números na senha (ela entra na URL de conexão da API).
# Gere com: openssl rand -hex 24
POSTGRES_USER=bolao
POSTGRES_PASSWORD=troque-por-uma-senha-forte
POSTGRES_DB=bolao

# Segredo do JWT de sessão da API. Gere com: openssl rand -base64 48
JWT_SECRET=troque-por-um-segredo-aleatorio

# Código de convite do cadastro (passe só para os participantes).
# Vazio = cadastro desativado.
SIGNUP_CODE=
